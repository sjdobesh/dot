# get unique package entries an array
#
# mine but should be installed at base level
DOT_REPO=("sjdobesh/dot.git")

# personal project repositories
PRIVATE_REPOS=(
  "sjdobesh/pngz.git"
  "sjdobesh/pxl.git"
  "sjdobesh/sdlwin.git"
)

# public git repositories
PUBLIC_REPOS=(
  "nothings/stb.git"
  "attractivechaos/klib.git"
  "neovim/neovim"
)

# rust utils
CRATES=(
  "eza"
  "bat"
  "tealdeer"
  "ripgrep"
  "--locked tree-sitter-cli"
)

# global error log #-----------------------------------------------------------

ERROR_LOG=()

log_errors () {
  if [[ $? != 0 ]]; then
    ERROR_LOG+=("$1")
  fi
}

print_error_log() {
  if [[ "${#ERROR_LOG[@]}" -gt 0 ]]; then
    echo
    echo "+--------------[ ERROR ]----------------+"
    for err in "${ERROR_LOG[@]}"; do
      echo "> $err"
    done
    echo "+---------------------------------------+"
    echo
    ERROR_LOG=() # reset list
  fi
}

# install #---------------------------------------------------------------------
# install all apt packages and update
# DEPRECATED!!!
install_packages() {
  echo "[ installing apt packages... ]"

  sudo apt-get update -y
  for pkg in "${PACKAGES[@]}"; do
    echo "installing $pkg..."
    # do this in package order
    if dpkg -s "$pkg" 2>&1 | grep "not installed" > /dev/null; then
      sudo apt-get install -y "$pkg"
      log_errors "error installing apt package [$pkg]"
    else
      echo "$pkg already installed"
    fi
  done

  echo "[ updating system... ]"

  sudo apt-get update -y
  sudo apt-get upgrade -y
  sudo apt-get autoclean -y
  sudo apt-get autoremove -y

  echo "[ system up to date ]"
}

# DEPRECATED
uninstall_packages() {
  echo
  echo "[ uninstalling apt packages... ]"

  for pkg in "${PACKAGES[@]}"; do
    echo "installing $pkg..."
    if dpkg -s "$pkg" 2>&1 | grep "not installed" > /dev/null; then
      echo "$pkg not installed, nothing to remove..."
    else
      sudo apt-get purge -y "$pkg"
      log_errors "error purging apt package [$pkg]"
    fi
  done
  sudo apt-get autoclean -y
  sudo apt-get autoremove -y

  echo "[ uninstalled apt packages ]"
  echo
}

# install neovim from source
install_nvim() {
  echo
  echo "[ installing neovim... ]"

  # check if source is available
  if [[ ! -d ~/repos/neovim ]]; then
    echo "couldn't find repository, downloading now"
    mkdir -p ~/repos
    cd ~/repos
    git clone https://github.com/neovim/neovim
  fi

  # build from source and install to ~/bin
  cd ~/repos/neovim
  make CMAKE_BUILD_TYPE=Release CMAKE_EXTRA_FLAGS="-DCMAKE_INSTALL_PREFIX=$HOME/bin/neovim"
  sudo make install
  export PATH="$HOME/bin/neovim/bin:$PATH"
  cd ~

  echo "[ installed neovim ]"
  echo
}

uninstall_nvim() {
  echo
  echo "[ uninstalling neovim... ]"

  if [[ ! -d ~/repos/neovim ]]; then
    log_errors "error couldn't find neovim to uninstall"
    echo "[ neovim not installed ]"
    return
  fi
  cd ~/repos/neovim
  sudo cmake --build build/ --target uninstall
  log_errors "error during cmake build"
  cd ~

  echo "[ uninstalled neovim ]"
  echo
}

# install rust (rustup + crates)
install_rust() {
  echo
  echo "[ installing rust... ]"

  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
  log_errors "error installing rust"
  export PATH=$PATH:$HOME/.cargo/bin
  rustup self update
  rustup update
  log_errors "error during rust update"
  rustup toolchain install nightly
  log_errors "error during rust nightly install"

  echo "[ rust installed ]"
  sleep 1
  echo
}

install_crates() {
  echo
  echo "[ installing crates... ]"

  for crate in "${CRATES[@]}"; do
    echo "installing $crate..."
    cargo install $crate
    log_errors "error installing rust crate [$crate]"
  done

  echo "[ crates installed ]"
  sleep 1
  echo
}

uninstall_crates() {
  echo
  echo "[ uninstalling crates... ]"

  for crate in "${CRATES[@]}"; do
    echo "uninstalling $crate..."
    cargo uninstall $crate
    log_errors "error uninstalling rust crate [ $crate ]"
  done

  echo "[ crates uninstalled ]"
  sleep 1
  echo
}

uninstall_rust() {
  echo "[ uninstalling rust... ]"
  rustup self uninstall
  log_errors "error uninstalling rust"
  echo "[ uninstalled rust ]"
}

install_haskell() {
  echo
  echo "[ installing haskell... ]"
  curl --proto '=https' --tlsv1.2 -sSf https://get-ghcup.haskell.org | \
    BOOTSTRAP_HASKELL_NONINTERACTIVE=1 \
    BOOTSTRAP_HASKELL_GHC_VERSION=latest \
    BOOTSTRAP_HASKELL_CABAL_VERSION=latest \
    BOOTSTRAP_HASKELL_INSTALL_STACK=1 \
    BOOTSTRAP_HASKELL_INSTALL_HLS=1 \
    BOOTSTRAP_HASKELL_ADJUST_BASHRC=P \
    sh
  log_errors "error installing haskell"
  echo "[ installed haskell ]"
  echo
}
uninstall_haskell() {
  echo
  echo "[ uninstalling haskell... ]"

  ghcup nuke
  log_errors "error nuking haskell"
  rm -rf ~/.ghcup ~/.cabal ~/.stack

  echo "[ uninstalled haskell ]"
  echo
}

# helper function
download_repo_set() {
  local -n arr_ref="$1"
  for repo_url in "${arr_ref[@]}"; do
    repo_name="$(basename "$repo_url" .git)"
    echo "installing $repo_name with $repo_url to $2."
    if [[ ! -d ~/$2/$repo_name ]]; then
      git -C ~/$2 clone "$https_prefix$repo_url"
      log_errors "error downloading repository $repo_name to $2"
    else
      echo "found $repo_name, pulling latest changes..."
      git -C ~/$2/$repo_name pull
      log_errors "error pulling $repo_name"
    fi
  done
}

# download personal and external github repos
download_private_repos() {
  echo
  echo "[ downloading private git repositories into ~/projects... ]"

  mkdir -p ~/projects
  download_repo_set PERSONAL_REPOS projects

  echo "[ repositories downloaded ]"
  echo
}

# download personal and external github repos
download_public_repos() {
  echo
  echo "[ downloading public git repositories into ~/repos... ]"

  mkdir -p ~/repos
  download_repo_set PUBLIC_REPOS repos

  echo "[ repositories downloaded ]"
  echo
}

remove_public_repos() {
  echo
  echo "[ removing public git repositories in ~/public... ]"

  for repo in ${PUBLIC_REPOS[@]}; do
    echo "removing $repo..."
    rm -rf ~/repos/$repo
    echo "$repo removed"
  done

  echo "[ removed public git repositories ]"
  echo
}

remove_private_repos() {
  # should check for unstaged commits as well
  echo
  echo "[ removing private git repositories in ~/projects... ]"

  for repo in ${PRIVATE_REPOS[@]}; do
    echo "removing $repo..."
    cd ~/projects/"$repo"
    gstatus=`git status -s | wc -l`
    if (( gstatus )); then
      echo "error, found git conflicts in $repo, please resolve before deleting"
      break
    else
      echo "removing $repo"
      read -p "[ press any key to continue ] > "
      rm -rf ~/projects/$repo
      echo "$repo removed"
    fi
  done

  echo "[ removed private git repositories ]"
  echo
}

# download documentation sources (just sdl3 for now)
download_docs() {
  echo
  echo "[ downloading documentation... ]"

  cd ~
  mkdir ~/docs
  curl -LO https://wiki.libsdl.org/static_files/offline/sdlwiki.zip
  log_errors "error downloading documentation"
  mv sdlwiki.zip ~/docs
  cd ~/docs
  unzip sdlwiki.zip
  log_errors "error extracting documentation"
  rm sdlwiki.zip
  cd ~

  echo "[ documentation downloaded ]"
  echo
}

remove_docs() {
  echo
  echo "[ removing documentation... ]"
  rm -rf ~/docs
  echo "[ removed documentation ]"
  echo
}

# use the stow util to create managed symlinks for configs and scripts
stow_configs() {
  echo
  echo "[ stowing symlinks... ]"

  echo "dotfiles..."
  cd ~/dot/.dotfiles
  stow --no-folding --adopt -vt ~ */
  log_errors "error stowing configs"

  echo "scripts..."
  cd ~/dot/scripts
  stow --no-folding --adopt -vt ~ */
  log_errors "error stowing scripts"
  cd ~

  # change shells now that there is a .zshrc
  chsh -s $(which zsh)

  echo "[ symlinks stowed ]"
  echo
}

unstow_configs() {
  echo
  echo "[ unstowing symlinks... ]"

  echo "dotfiles..."
  cd ~/dot/.dotfiles
  stow -D --no-folding --adopt -vt ~ */
  log_errors "error unstowing configs"

  echo "scripts..."
  cd ~/dot/scripts
  stow -D --no-folding --adopt -vt ~ */
  log_errors "error unstowing scripts"
  cd ~

  echo "[ symlinks unstowed ]"
  echo
}

# init ssh keys and github ssh remotes for personal repos
init_ssh() {
  echo
  echo "[ setting up ssh...]"

  # make sure public ssh key is available
  count=`ls ~/.ssh -1 *.pub 2>/dev/null | wc -l`
  if (( count == 0 )); then
    echo "no pub key found, generating new ssh key..."
    ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -q -N ""
    log_errors "error in ssh keygen"
  else
    echo "found existing ssh key."
  fi

  echo "setting git config user to $git_name at $git_email."
  git config --global user.email "$git_email"
  git config --global user.name "$git_name"

  # only update personal remotes, including dot repo
  echo "updating repo remote urls for person repos..."
  UPDATEABLE_REPOS=("${PRIVATE_REPOS[@]}" "${DOT_REPO[@]}")
  for repo_url in "${UPDATEABLE_REPOS[@]}"; do
    repo_name="$(basename "$repo_url" .git)"
    echo "swapping $repo_name to ssh origin..."
    if [[ -d ~/repos/$repo_name ]]; then
      git -C ~/repos/$repo_name remote set-url origin $ssh_prefix$repo_url
      log_errors "error updating $repo_name origin to $ssh_prefix$repo_url"
    else
      echo "couldn't find $repo_name."
    fi
  done
  echo "remote origins set."

  echo "ssh pub key :"
  'cat' ~/.ssh/*.pub

  echo "[ ssh initialized ]"
  echo
}

# full installations -----------------------------------------------------------

install_all() {
  echo
  echo "[ installing full environment... ]"

  install_packages
  install_rust
  install_haskell
  install_nvim
  download_repos
  download_docs
  init_ssh
  stow_configs

  echo "[ full environment installed. ]"
  echo
  print_error_log
	exit
}

uninstall_all() {
  echo
  echo "[ uninstalling full environment... ]"

  uninstall_packages
  uninstall_rust
  uninstall_haskell
  uninstall_nvim
  remove_repos
  remove_docs
  unstow_configs

  echo "[ full environment uninstalled. ]"
  echo
  print_error_log
	exit
}

