# args: user input, error flag
read_input() {
  local -n user_input="$1"
  local -n input_error="$2"
  # different print on error
  if (( input_error )); then
    input_error=0
    read -p "[invalid selection]:" user_input
  else
    read -p ":" user_input
  fi
}


# INSTALLER #-------------------------------------------------------------------

# apt package helper functions

get_selected_packages() {

  local -n ordered_keys="$1"
  local -n selected_package_groups="$2"
  local -n package_list="$3"

  for key in "${ordered_keys[@]}"; do
    if ((  selected_package_groups["$key"] )); then
      keyref="${key}[@]"
      package_list+=("${!keyref}")
    fi
  done

}

get_unique_packages() {

  local   -n input_pkgs="$1"
  local   -n unique_pkgs="$2"
  declare -A found_pkgs # track found pkgs in dictionary

  for pkg in "${input_pkgs[@]}"; do
    if [[ -z "${found_pkgs[$pkg]}" ]]; then
      unique_pkgs+=("$pkg")
      found_pkgs["$pkg"]=1
    fi
  done
}

get_apt_command() {

  local -n install_command="$1"
  local -n in_or_un="$2"

  install_command="sudo apt-get "
  if (( $in_or_un )); then
    install_command+="install -y "
  else
    install_command+="purge -y "
  fi

  install_command+="${UNIQUE_PACKAGES[@]}"

}

get_apt_descriptions() {
  for group in "${APT_ORDERED_KEYS[@]}"; do
    if [[ "${APT_INSTALL_SELECTION[$group]}" -eq 1 ]]; then
      echo -e "${APT_DESCRIPTIONS[$group]}"
    fi
  done
  read -p "[ press any key to continue ] > "
}

apt_installer() {

  local install_option="$1" # install (1) or uninstall (0)
  # assemble package list and remove duplicates
  INSTALL_PACKAGES=()
  UNIQUE_PACKAGES=()

  # get a list of all packages from the selected groups
  get_selected_packages APT_ORDERED_KEYS APT_INSTALL_SELECTION INSTALL_PACKAGES

  # error catch empty
  if [[ -z "${INSTALL_PACKAGES[@]}" ]]; then
    echo "nothing selected to install"
    sleep 1
    return
  fi

  # remove duplicate pkgs
  get_unique_packages INSTALL_PACKAGES UNIQUE_PACKAGES

  # make an apt-get command to execute
  get_apt_command apt_command install_option

  # get user approval
  echo "[ proposed command ]"
  echo
  echo "$apt_command"
  echo
  read -p "[ approve execution? (y/n) ] > " user_input

  # execute command
  if [[ "$user_input" == y ]]; then
    echo
    echo "[ updating packages references ... ]"
    sudo apt-get update -y
    echo "[ packages references updated ]"
    echo
    echo "[ installing package groups ... ]"
    echo $apt_command
    $apt_command
    echo "[ package groups installed ]"
    sleep 1
  else
    echo
    echo "[ aborting install ]"
    sleep 1
    return
  fi
  echo
  echo "[ updating and cleaning... ]"
  sudo apt-get update -y
  sudo apt-get upgrade -y
  sudo apt-get autoclean -y
  sudo apt-get autoremove -y
  echo "[ package refresh complete ]"

  # update user on new packages available
  echo
  echo "[ added the following packages... ]"
  for pkg in "${UNIQUE_PACKAGES[@]}"; do
    echo "- [ $pkg ]"
  done
  echo
  read -p "[ press any key to continue ] > "
}

rust_installer() {
  local install_option="$1" # install (1) or uninstall (0)
  if (( RUST_INSTALL_SELECTION["RUSTUP"] )); then
    if (( install_option )); then
      install_rust
    else
      uninstall_rust
    fi
  fi
  if (( RUST_INSTALL_SELECTION["CRATES"] )); then
    if (( install_option )); then
      install_crates
    else
      uninstall_crates
    fi
  fi
}

repo_installer() {
  local install_option="$1" # install (1) or uninstall (0)
  if (( REPO_INSTALL_SELECTION["PRIVATE"] )); then
    if (( install_option )); then
      download_private_repos
    else
      remove_repos
    fi
  fi
  if (( REPO_INSTALL_SELECTION["PUBLIC"] )); then
    if (( install_option )); then
      download_public_repos
    else
      remove_repos
    fi
  fi
}

# PROMTPS #---------------------------------------------------------------------
# apt_prompt
# rust_prompt
# haskell_prompt
# nvim_prompt
# repo_prompt
# main_menu_prompt

apt_prompt() {

  user_selection=0
  error=0

  while : ; do
    clear
    print_error_log
    print_apt_menu
    read_input user_selection error

    # toggle selections
    case "$user_selection" in
      "1" ) (( APT_INSTALL_SELECTION["CORE"]        = !APT_INSTALL_SELECTION["CORE"]        )) ;;
      "2" ) (( APT_INSTALL_SELECTION["NETWORKING"]  = !APT_INSTALL_SELECTION["NETWORKING"]  )) ;;
      "3" ) (( APT_INSTALL_SELECTION["CDEV"]        = !APT_INSTALL_SELECTION["CDEV"]        )) ;;
      "4" ) (( APT_INSTALL_SELECTION["CXTRA"]       = !APT_INSTALL_SELECTION["CXTRA"]       )) ;;
      "5" ) (( APT_INSTALL_SELECTION["NVIM_DEP"]    = !APT_INSTALL_SELECTION["NVIM_DEP"]    )) ;;
      "6" ) (( APT_INSTALL_SELECTION["HASKELL_DEP"] = !APT_INSTALL_SELECTION["HASKELL_DEP"] )) ;;
      "7" ) (( APT_INSTALL_SELECTION["PROG_LANGS"]  = !APT_INSTALL_SELECTION["PROG_LANGS"]  )) ;;
      "8" ) (( APT_INSTALL_SELECTION["FULL"]        = !APT_INSTALL_SELECTION["FULL"]        )) ;;
      "9" )
        (( APT_INSTALL_SELECTION["ALL"]         = !APT_INSTALL_SELECTION["ALL"]         ))
        EVERYTHING_ELSE=("${APT_ORDERED_KEYS[@]:0:$((${#APT_ORDERED_KEYS[@]} - 1))}")
        if (( APT_INSTALL_SELECTION["ALL"] )); then
          val=1
        else
          val=0
        fi
        for key in "${EVERYTHING_ELSE[@]}"; do
            APT_INSTALL_SELECTION["$key"]=$val
        done
      ;;
      [i] ) apt_installer 1        ;;
      [u] ) apt_installer 0 ;;
      [\?] ) get_apt_descriptions ;;
      [b] ) main_menu_prompt ;;
      [q] ) exit             ;;
      *   ) error=1          ;;
    esac

  done
}

rust_prompt() {
  user_selection=0
  error=0
  while : ; do
    clear
    print_error_log
    print_rust_menu
    read_input user_selection error
    case "$user_selection" in
