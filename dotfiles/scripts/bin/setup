main_menu_prompt() {
  user_selection=0
  error=0

  while : ; do
    clear
    print_error_log
    print_main_menu
    read_input user_selection error
    # toggle selections
    case "$user_selection" in
      "1" ) apt_prompt     ;;
      "2" ) rust_prompt    ;;
      "3" ) haskell_prompt ;;
      "4" ) nvim_prompt    ;;
      "5" ) repo_prompt    ;;
      "6" ) doc_prompt     ;;
    esac
  done
}

# start log & prompt
LOG_FILE="setup.log"
exec > >(tee -a "$LOG_FILE") 2>&1
main_menu_prompt
