      "2" ) (( RUST_INSTALL_SELECTION["CRATES"]  = !RUST_INSTALL_SELECTION["CRATES"]  )) ;;
      [i] ) rust_installer 1 ;;
      [u] ) rust_installer 0 ;;
      [b] ) main_menu_prompt ;;
      [q] ) exit             ;;
      *   ) error=1          ;;
    esac
  done
}

