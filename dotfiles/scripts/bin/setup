# FORMAT MENUS #----------------------------------------------------------------

# pass $1 as line to format, $2 is the keyed value, selected or not
# inserts check mark
format_menu_checkbox() {
  local line="$1"
  local val=$2
  if (( val == 1 )) ; then
    line="${line/xxx/[x]}"
  else
    line="${line/xxx/[ ]}"
  fi
  echo "$line"
}

format_apt_menu() {
  for key in "${APT_ORDERED_KEYS[@]}"; do
    format_menu_checkbox "${APT_FORMATABLE_MENU[$key]}" "${APT_INSTALL_SELECTION[$key]}"
  done
}

format_rust_menu() {
  for key in "${RUST_ORDERED_KEYS[@]}"; do
    format_menu_checkbox "${RUST_FORMATABLE_MENU[$key]}" "${RUST_INSTALL_SELECTION[$key]}"
  done
}

format_repo_menu() {
  for key in "${REPO_ORDERED_KEYS[@]}"; do
    format_menu_checkbox "${REPO_FORMATABLE_MENU[$key]}" "${REPO_INSTALL_SELECTION[$key]}"
  done
}


